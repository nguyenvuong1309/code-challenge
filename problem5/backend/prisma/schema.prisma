// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// User management
model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique
  password    String   // Hashed password
  name        String
  walletAddress String? @unique @map("wallet_address") @db.VarChar(42)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  collections NFTCollection[]

  @@map("users")
  @@index([email], name: "idx_users_email")
  @@index([walletAddress], name: "idx_users_wallet")
}

// NFT Collection management
model NFTCollection {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(100)
  symbol          String   @db.VarChar(20)
  description     String?  @db.Text
  contractAddress String?  @unique @map("contract_address") @db.VarChar(42)
  chainId         Int      @default(1) @map("chain_id") // 1=Ethereum, 137=Polygon, 56=BSC
  creatorId       String   @map("creator_id") @db.Uuid
  totalSupply     Int      @default(0) @map("total_supply")
  maxSupply       Int?     @map("max_supply")
  mintPrice       Decimal  @default(0) @map("mint_price") @db.Decimal(20, 8)
  royaltyPercent  Decimal  @default(0) @map("royalty_percent") @db.Decimal(5, 2)
  metadataURI     String?  @map("metadata_uri") @db.Text
  imageURI        String?  @map("image_uri") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  isPublic        Boolean  @default(true) @map("is_public")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator         User @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  nfts            NFT[]

  @@map("nft_collections")
  @@index([chainId], name: "idx_nft_collections_chain")
  @@index([creatorId], name: "idx_nft_collections_creator")
  @@index([isActive, isPublic], name: "idx_nft_collections_status")
  @@index([createdAt], name: "idx_nft_collections_created_at")
}

// Individual NFTs in collections
model NFT {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenId      Int      @map("token_id")
  collectionId String   @map("collection_id") @db.Uuid
  ownerWallet  String?  @map("owner_wallet") @db.VarChar(42)
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  imageURI     String   @map("image_uri") @db.Text
  metadataURI  String   @map("metadata_uri") @db.Text
  attributes   Json     @default("{}") @db.JsonB // Traits/properties as JSON
  rarity       String?  @db.VarChar(20) // Common, Rare, Epic, Legendary
  isListed     Boolean  @default(false) @map("is_listed")
  listPrice    Decimal? @map("list_price") @db.Decimal(20, 8)
  mintedAt     DateTime @default(now()) @map("minted_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  collection   NFTCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, tokenId], name: "unique_collection_token")
  @@map("nfts")
  @@index([collectionId], name: "idx_nfts_collection")
  @@index([ownerWallet], name: "idx_nfts_owner")
  @@index([rarity], name: "idx_nfts_rarity")
  @@index([isListed], name: "idx_nfts_listed")
}

// Transaction history for NFTs
model NFTTransaction {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nftId         String      @map("nft_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  fromWallet    String?     @map("from_wallet") @db.VarChar(42)
  toWallet      String?     @map("to_wallet") @db.VarChar(42)
  price         Decimal?    @db.Decimal(20, 8)
  txHash        String?     @map("tx_hash") @db.VarChar(66)
  blockNumber   BigInt?     @map("block_number")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  nft           NFT @relation(fields: [nftId], references: [id], onDelete: Cascade)

  @@map("nft_transactions")
  @@index([nftId], name: "idx_nft_transactions_nft")
  @@index([transactionType], name: "idx_nft_transactions_type")
  @@index([createdAt], name: "idx_nft_transactions_created_at")
}

// Enums
enum TransactionType {
  MINT
  TRANSFER
  SALE
  LIST
  DELIST

  @@map("transaction_type")
}